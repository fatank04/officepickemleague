# ---- Database (Neon Postgres) ----
# Create a free project at neon.tech → copy the POOLED connection string into DATABASE_URL
# and the DIRECT (non-pooled) string into DIRECT_URL.
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
DIRECT_URL="postgresql://user:pass@host/db?sslmode=require"

# ---- The Odds API (https://the-odds-api.com) ----
ODDS_API_KEY="your_odds_api_key"

# ---- NFL season ----
SEASON="2026"

# ---- Auth / sessions (sign cookie + hash PINs) ----
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change_me_to_a_long_random_string"

# ---- Cron protection (Bearer token on scheduled requests) ----
CRON_SECRET="change_me_too"

# ---- SMS provider. Flip the whole texting stack with one var. ----
# "twilio-10dlc" (default) | "twilio-tollfree" | "telnyx". Unset => twilio-10dlc.
SMS_PROVIDER="twilio-10dlc"

# ---- Twilio (SMS + voice). Optional until you turn messaging on. ----
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# 10DLC: send through the Messaging Service the A2P campaign is attached to (preferred).
TWILIO_MESSAGING_SERVICE_SID=""
# Toll-free path (SMS_PROVIDER=twilio-tollfree): the verified toll-free number, E.164.
TWILIO_TOLLFREE_NUMBER=""
# Raw from-number: used as the 10DLC fallback and the toll-free fallback.
TWILIO_FROM_NUMBER=""

# ---- Telnyx (SMS_PROVIDER=telnyx). ----
TELNYX_API_KEY=""
# Prefer a Messaging Profile (holds the number pool); or set a single from-number.
TELNYX_MESSAGING_PROFILE_ID=""
TELNYX_FROM_NUMBER=""
# Inbound webhook (two-way): point the Messaging Profile at /api/sms/telnyx and paste the
# portal's Ed25519 public key here so inbound picks/STOP/HELP are signature-verified.
TELNYX_WEBHOOK_PUBLIC_KEY=""

# Phone to receive grading-gap alerts (E.164, e.g. +1412...)
ALERT_PHONE=""

# ---- Public base URL of the deployment (used by SMS/voice signature checks + links) ----
NEXT_PUBLIC_BASE_URL="https://officepickemleague.com"
